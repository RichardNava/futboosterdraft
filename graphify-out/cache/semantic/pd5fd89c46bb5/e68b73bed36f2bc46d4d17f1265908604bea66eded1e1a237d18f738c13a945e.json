{"nodes": [{"id": "specs_002_mejoras_mvp_research", "label": "Research Fase 0 spec 002 (R1-R19)", "file_type": "document", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r1_viabilidad_sincrono", "label": "R1 Viabilidad del modelo sincrono entre humanos (FR-029)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El asincrono elimina estado distribuido (relojes de varios clientes), deja el draft como unico punto sincrono y resuelve un partido en un comando (~25 ms)."}, {"id": "specs_002_mejoras_mvp_research_r2_reloj_condensado", "label": "R2 Reloj de reproduccion lineal condensado (K=23,5 ticks/s a x2)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reloj lineal define la homogeneidad; acotar el descuento a 1-3 min es la unica forma de cumplir SC-006 sin cambiar el ritmo dentro de una parte."}, {"id": "specs_002_mejoras_mvp_research_r3_capa_espacial", "label": "R3 Capa espacial continua y determinista (modulo espacio/)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sustituye la rejilla 6x3; debe estar en el motor para que cada accion visible sea una accion calculada (Principios IV y V). Descartados: movimiento inventado en cliente, Box2D/Rapier, rejilla con mejor interpolacion, coma flotante."}, {"id": "specs_002_mejoras_mvp_research_aritmetica_entera", "label": "Aritmetica entera en decimas con isqrt (sin coma flotante)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El orden de operaciones en flotantes puede variar entre motores JS; enteros garantizan determinismo."}, {"id": "specs_002_mejoras_mvp_research_r4_seleccion_acciones", "label": "R4 Seleccion de acciones con puntuacion espacial y densidad", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Puntuar pases con datos espaciales hace emerger paredes, cambios de orientacion y contraataques; duraciones salen de la fisica, sin acciones fantasma."}, {"id": "specs_002_mejoras_mvp_research_r5_fotogramas_hermite", "label": "R5 Fotogramas v2 cada 2 ticks con suavizado de Hermite cubica", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r6_bufer_anticipacion", "label": "R6 Bufer de anticipacion de 60 ticks en 2D en directo contra NPC", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simular tramo a tramo provoca tirones en ~60 interrupciones; simular todo impide decisiones en directo. Bufer de 3 s reales descartado porque a x8 retrasaba cambios ~5 min de juego."}, {"id": "specs_002_mejoras_mvp_research_r7_resolverresto", "label": "R7 Finalizar partido y procedimiento unico resolverResto", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un solo camino para resolver lo que queda de partido garantiza la equivalencia por construccion."}, {"id": "specs_002_mejoras_mvp_research_r8_resolucion_entre_humanos", "label": "R8 Resolucion unica entre humanos, visionado y 'pendiente de ver'", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolver al abrir (no al abrir la jornada) permite cambiar alineacion mientras nadie abra; recalcular fotogramas evita guardar ~0,7 MB por partido. Nivel 'avanzado' por ser el mas alto sin simulaciones de prueba."}, {"id": "specs_002_mejoras_mvp_research_r9_ritmo_deducido", "label": "R9 Ritmo del torneo deducido del numero de humanos (se elimina ritmo)", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r10_pausa_solitario", "label": "R10 Pausa de partidas en solitario con partida.pausar", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r11_abandono_confirmado", "label": "R11 Abandono confirmado desde la barra (useBlocker)", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r12_penalizacion_parametros", "label": "R12 Penalizacion por posicion en ParametrosEquilibrado 2.0.0", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Principio III: valores explicitos y probados en un unico sitio; version mayor deja trazado que motor y parametros cambian a la vez."}, {"id": "specs_002_mejoras_mvp_research_r13_zonas_ofensividad", "label": "R13 Zonas, colocacion libre y formula de ofensividad/amplitud", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El ajuste relativo a la formacion de partida es la unica formula sencilla que coincide exactamente con la tabla de 001; un modelo lineal por lineas no reproduce 4-3-3, 4-2-3-1 y 3-3-3-1."}, {"id": "specs_002_mejoras_mvp_research_r14_dorsales", "label": "R14 Dorsales: asignarDorsal y completarDorsales", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r15_aportaciones", "label": "R15 Aportaciones por partido para goleadores y asistentes", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guardar aportaciones por partido (no totales) permite excluir el partido no visto de un participante."}, {"id": "specs_002_mejoras_mvp_research_r16_diseno_cartas", "label": "R16 Diseno de cartas (CSS, container queries, popover)", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r17_animacion_sonido", "label": "R17 Animacion de apertura marcada por el servidor y Web Audio", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La marca animacion:true del servidor resuelve a la vez 'solo el sobre propio' y 'no repetir al reconectar'."}, {"id": "specs_002_mejoras_mvp_research_r18_navegacion_avanzar", "label": "R18 Marco de navegacion y componente unico BotonAvanzar con requestId", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r19_verificacion_sc", "label": "R19 Verificacion de los criterios de exito (balance, cinematica, Playwright)", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_002_mejoras_mvp_research_r1_viabilidad_sincrono", "target": "specs_002_mejoras_mvp_spec_modelo_asincrono", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_002_mejoras_mvp_research_r2_reloj_condensado", "target": "specs_002_mejoras_mvp_spec_velocidades_2d", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_002_mejoras_mvp_research_r2_reloj_condensado", "target": "specs_002_mejoras_mvp_spec_pausas_anunciadas", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_002_mejoras_mvp_research_r3_capa_espacial", "target": "specs_002_mejoras_mvp_spec_realismo_2d", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_002_mejoras_mvp_research_r4_seleccion_acciones", "target": "specs_002_mejoras_mvp_spec_sc_007", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/0