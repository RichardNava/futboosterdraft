{"nodes": [{"id": "specs_001_draft_manager_mvp_research_doc", "label": "Research Fase 0 (R1-R17)", "file_type": "document", "source_file": "specs/001-draft-manager-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_research_r3_websocket", "label": "R3: WebSocket (ws) + Zod", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/research.md", "source_location": "R3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft simult\u00e1neo y 2D requieren push inmediato; requestId descarta duplicados. Socket.IO y Colyseus descartados."}, {"id": "specs_001_draft_manager_mvp_research_r4_actor_por_partida", "label": "R4: Actor en memoria por partida", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/research.md", "source_location": "R4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cola serializada elimina condiciones de carrera del turno simult\u00e1neo; guardar antes de anunciar."}, {"id": "specs_001_draft_manager_mvp_research_r5_postgresql", "label": "R5: PostgreSQL 16 + Drizzle", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/research.md", "source_location": "R5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modelo relacional con transacciones y unicidad; JSONB para stats y eventos."}, {"id": "specs_001_draft_manager_mvp_research_r6_temporizadores", "label": "R6: Temporizadores en memoria con vencimiento persistido", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/research.md", "source_location": "R6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin pg-boss: el actor serializa y vence_en cubre reinicios; desviaci\u00f3n del plan inicial."}, {"id": "specs_001_draft_manager_mvp_research_r7_motor_determini