{"nodes": [{"id": "specs_003_mejoras_ux_simulacion_research_research", "label": "Research Fase 0 spec 003 (R1-R25)", "file_type": "document", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r1_linea_base", "label": "R1 Linea base del motor (c8a1627)", "file_type": "rationale", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2,91 goles/partido ya en rango; fallan penaltis 3,8%, faltas directas 2,4%, 1-2 al 20%, receptor sin direccion, rivalCercano busca al mas debil. El problema es seleccion de acciones y coherencia espacial, no cantidad de goles."}, {"id": "specs_003_mejoras_ux_simulacion_research_r2_parametros_v3", "label": "R2 Parametros 3.0.0 (v3.json)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El motor cambia en codigo, no solo magnitudes; subir version mayor deja claro que los partidos 2.x no se reproducen (VersionNoSoportada). Se descarta mantener motor 2 en paralelo (Principio V)."}, {"id": "specs_003_mejoras_ux_simulacion_research_r3_receptor", "label": "R3 Receptor por tipo de pase, distancia y direccion", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El pase atras irracional es un problema de eleccion de receptor; filtrar por distancia y direccion reales mapea directamente a SC-004/SC-005. atraccionPasador baja de 2 a 0,6 acotado [0,7,1,6]; interceptor en el carril con isqrt."}, {"id": "specs_003_mejoras_ux_simulacion_research_r4_pase_largo_motivo", "label": "R4 Pase largo solo con motivo tactico", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cinco motivos booleanos (cambio de orientacion, espalda, salida bajo presion, despeje, contraataque); sin motivo x0,15, con motivo x1,3. Solo bajar pesos seguiria generando pases sin sentido."}, {"id": "specs_003_mejoras_ux_simulacion_research_r5_conduccion_espacio", "label": "R5 Conduccion proporcional al espacio", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r6_tiro_distancia", "label": "R6 Tiro por distancia y angulo reales", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lo que se ve en la 2D coincide con lo que calcula el motor; pesoPorTramo con zonas area/frontal/lejos; xG continuo con coma flotante descartado por determinismo entero. Decision usuario 2026-10-19: ~25% goles fuera del area."}, {"id": "specs_003_mejoras_ux_simulacion_research_r7_balon_parado", "label": "R7 Variedad de goles: penaltis, faltas directas, cabeza", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aumentar situaciones que originan goles con criterios espaciales (penalti si la falta esta dentro del area real) en vez de inventar goles."}, {"id": "specs_003_mejoras_ux_simulacion_research_r8_orden_calibracion", "label": "R8 Media de goles, serie Core y orden de calibracion", "file_type": "rationale", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orden fijo receptor->conduccion->stats/specials->tiro->balon parado->gol para que cada paso sea atribuible y reversible; se descarta un factor de forma por partido (Principio I)."}, {"id": "specs_003_mejoras_ux_simulacion_research_r9_factorstat", "label": "R9 factorStat: peso de los stats en la eleccion", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Factor lineal acotado (ref 70) facil de explicar y probar; factores exponenciales concentrarian la accion contra la cota del 60%. Se quita 'busca al mas debil' para que el mejor defensa defienda mas."}, {"id": "specs_003_mejoras_ux_simulacion_research_r10_specials", "label": "R10 Peso medible de los specials", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L206", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r11_metricas", "label": "R11 Metricas de equilibrado (MetricasJugador, golesPorTipo/Zona)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metricas por jugador solo con opciones.metricas, sin consumir PRNG (invariante 10) y sin persistir para no inflar el JSON del partido."}, {"id": "specs_003_mejoras_ux_simulacion_research_gol_propia_puerta", "label": "Gol en propia puerta (tipo 'propia', tiro.autogol)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L231", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r12_errores_npc", "label": "R12 Dificultad NPC por calidad de decision (PerfilNPC.errores)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L235", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalogo de errores por familia con probabilidad y coste maximo, explicito y probable; mas ruido en el evaluador no controla la gravedad; peores cartas o porcentajes por nivel prohibidos por FR-037."}, {"id": "specs_003_mejoras_ux_simulacion_research_guardarrail_errores", "label": "Guardarrail contra decisiones absurdas", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L262", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_perfil_automatico", "label": "Perfil 'automatico' (avanzado sin errores)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L269", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r13_participante_referencia", "label": "R13 Participante de referencia", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L276", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SC-010 se mide contra un jugador medio con comportamiento fijo que no evoluciona con los perfiles NPC; NPC contra NPC no refleja la experiencia humana."}, {"id": "specs_003_mejoras_ux_simulacion_research_r14_formacion_campo_unico", "label": "R14 Formacion con un unico campo", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L294", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r15_vista_ampliada", "label": "R15 Vista ampliada de la carta", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L313", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "popover=manual en top layer y posicionamiento calculado en JS porque CSS anchor positioning no tiene soporte uniforme; sin libreria de popovers."}, {"id": "specs_003_mejoras_ux_simulacion_research_r16_boton_principal", "label": "R16 Boton principal fijo y comun", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L328", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sticky dentro del contenedor del Marco en vez de position:fixed, que choca con el teclado virtual y el modo compacto 2D."}, {"id": "specs_003_mejoras_ux_simulacion_research_r17_gestion_partido", "label": "R17 Gestion del equipo durante el partido", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L345", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estado del equipo derivado en el cliente con lo ya visto para no revelar el bufer de 60 ticks (Principio VI); lote atomico evita estados intermedios invalidos."}, {"id": "specs_003_mejoras_ux_simulacion_research_lote_decisiones", "label": "Lote atomico partido.decisiones", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L361", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r18_resultado", "label": "R18 Pantalla de resultado al finalizar", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L377", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r19_modo_por_partido", "label": "R19 Modo de simulacion por partido", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L386", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El modo no afecta al calculo (Principio V), basta decidirlo en abrir, que ya es el punto unico e idempotente; un mensaje WS aparte introduciria una carrera."}, {"id": "specs_003_mejoras_ux_simulacion_research_r20_diseno_cartas", "label": "R20 Diseno de las cartas (Barlow Condensed OFL)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L403", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuente condensada permite agrandar numeros sin agrandar la carta; servida localmente, sin CDN, sin elementos de marca EA SPORTS FC."}, {"id": "specs_003_mejoras_ux_simulacion_research_r21_apertura_sobres", "label": "R21 Apertura de sobres, particulas y sonido sintetizado", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L426", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Particulas Canvas 2D con presupuesto de 6 ms/fotograma; sonido Web Audio sin licencia que gestionar y ajustable; margen draft 8 s."}, {"id": "specs_003_mejoras_ux_simulacion_research_r22_eliminaciones", "label": "R22 Eliminaciones derivadas y simular resto del torneo", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L455", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derivar eliminaciones de EstadoTorneo evita estado duplicado; reutilizar abrirSiguienteJornada garantiza mismas reglas (Principio V)."}, {"id": "specs_003_mejoras_ux_simulacion_research_humanos_en_competicion", "label": "humanosEnCompeticion", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L464", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r23_nombre_equipo", "label": "R23 Nombre del equipo y perfil de la cuenta", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L483", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tabla perfiles_usuario separada para no acoplar el esquema a better-auth."}, {"id": "specs_003_mejoras_ux_simulacion_research_perfiles_usuario", "label": "Tabla perfiles_usuario", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L493", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_r24_equipaciones_v2", "label": "R24 Equipaciones v2 (diseno + hasta 3 colores)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L503", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parecido con pesos de superficie considera todos los colores (FR-047); CIEDE2000 descartado por complejidad; una sola funcion patronDiseno asegura que vista previa y 2D coinciden."}, {"id": "specs_003_mejoras_ux_simulacion_research_patrondiseno", "label": "patronDiseno(diseno, colores)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L529", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_mejoras_ux_simulacion_research_parecido_equipaciones", "label": "Regla de parecido de equipaciones (umbral 0,45)", "file_type": "concept", "source_file": "specs/003-mejoras-ux-simulacion/research.md", "source_location": "L519", "source_url": null, "captured_at": null, "author": null, "contributor"