{"nodes": [{"id": "specs_002_mejoras_mvp_research_research", "label": "Research Fase 0 spec 002 (R1-R19)", "file_type": "document", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r1_viabilidad_sincrono", "label": "R1 Viabilidad del modelo sincrono entre humanos", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El asincrono elimina estado distribuido (relojes de varios clientes), evita que el humano mas lento marque el ritmo y deja el draft como unico punto sincrono."}, {"id": "specs_002_mejoras_mvp_research_r2_reloj_reproduccion", "label": "R2 Reloj de reproduccion condensado (K=23,5 ticks/s a x2)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reloj lineal define la homogeneidad; acotar el descuento a 1-3 min es la unica forma de cumplir SC-006 sin cambiar el ritmo dentro de una parte."}, {"id": "specs_002_mejoras_mvp_research_r3_capa_espacial", "label": "R3 Capa espacial continua y determinista (modulo espacio/)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El problema de la 2D era estructural (rejilla 6x3); se descartan animacion en cliente, motor de fisica y coma flotante para mantener un unico calculo determinista."}, {"id": "specs_002_mejoras_mvp_research_aritmetica_entera_isqrt", "label": "Aritmetica entera en decimas con isqrt", "file_type": "concept", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El orden de operaciones en coma flotante puede variar entre motores JS; enteros garantizan determinismo."}, {"id": "specs_002_mejoras_mvp_research_r4_seleccion_acciones", "label": "R4 Seleccion de acciones con puntuacion espacial y densidad", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si duracion y fisica salen de la misma fuente no hay acciones fantasma; paredes y contraataques emergen de la puntuacion espacial en vez de guiones."}, {"id": "specs_002_mejoras_mvp_research_r5_fotogramas_hermite", "label": "R5 Fotogramas v2 cada 2 ticks con suavizado Hermite", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r6_bufer_anticipacion", "label": "R6 Bufer de anticipacion de 60 ticks en directo contra NPC", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simular tramo a tramo provoca tirones por ida y vuelta; simular todo impide decisiones. Un bufer de 3 s reales se descarto porque a x8 retrasaba demasiado las decisiones."}, {"id": "specs_002_mejoras_mvp_research_r7_resolverresto", "label": "R7 resolverResto: procedimiento unico para finalizar", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un solo camino para resolver el resto del partido garantiza la equivalencia por construccion."}, {"id": "specs_002_mejoras_mvp_research_r8_partidos_entre_humanos", "label": "R8 Partidos entre humanos: resolucion unica y pendiente de ver", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolver al abrir permite cambiar la alineacion hasta entonces; fotogramas recalculados (cache LRU de 32) en vez de guardar ~0,7 MB por partido; nivel avanzado por ser determinista y barato."}, {"id": "specs_002_mejoras_mvp_research_r9_ritmo_torneo", "label": "R9 Ritmo del torneo deducido del numero de humanos", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r10_pausa_solitario", "label": "R10 Pausa de partidas en solitario con partida.pausar", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r11_abandono", "label": "R11 Abandono confirmado desde la barra (useBlocker)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r12_penalizacion", "label": "R12 Penalizacion por posicion en parametros 2.0.0", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r13_colocacion_zonas", "label": "R13 Colocacion libre, zonas y ofensividad calculada", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El ajuste relativo a la formacion de partida es la unica formula sencilla que coincide exactamente con la tabla de ofensividad de la spec 001."}, {"id": "specs_002_mejoras_mvp_research_r14_dorsales", "label": "R14 Dorsales unicos por construccion", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r15_goleadores", "label": "R15 Goleadores y asistentes por aportaciones", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guardar aportaciones por partido permite excluir el partido no visto de cada participante."}, {"id": "specs_002_mejoras_mvp_research_r16_cartas", "label": "R16 Diseno de cartas (CSS, container queries, popover)", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r17_apertura_sonido", "label": "R17 Animacion de apertura de sobre y sonido Web Audio", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La marca animacion:true del servidor en el primer draft.turno resuelve a la vez solo el sobre propio y no repetir al reconectar."}, {"id": "specs_002_mejoras_mvp_research_r18_barra_boton_avanzar", "label": "R18 Marco de navegacion y componente unico BotonAvanzar con requestId", "file_type": "rationale", "source_file": "specs/002-mejoras-mvp/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_mejoras_mvp_research_r19_verificacion", "label": "R19 Verificacion de los criterios de exito (balance, cinematica)", "file_type": "rationa