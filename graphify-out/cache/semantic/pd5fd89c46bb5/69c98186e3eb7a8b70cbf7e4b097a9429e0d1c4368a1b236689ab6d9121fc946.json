tured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_spec_booster_draft", "label": "Booster draft simult\u00e1neo de 3 sobres x 8 cartas", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-006..FR-012", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El draft es el n\u00facleo de la experiencia (Principio II); circulaci\u00f3n izquierda/derecha/izquierda con elecci\u00f3n simult\u00e1nea oculta."}, {"id": "specs_001_draft_manager_mvp_spec_cupos_sobre", "label": "Cupos fijos de demarcaci\u00f3n y nivel por sobre (FR-014)", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-014", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hueco 'POR o DEF' al 50% para no generar exceso de porteros; carta alta Legendario 80% / GOAT 20%."}, {"id": "specs_001_draft_manager_mvp_spec_jugador_carta", "label": "Jugador (carta)", "file_type": "concept", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-016..FR-024", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_spec_specials", "label": "Specials (habilidades de jugador)", "file_type": "concept", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-022, FR-037", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_spec_formaciones", "label": "10 formaciones y ofensividad", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-025, FR-034", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formaci\u00f3n ofensiva aumenta goles a favor y en contra; defensiva reduce ambos."}, {"id": "specs_001_draft_manager_mvp_spec_opciones_tacticas", "label": "Opciones t\u00e1cticas agrupadas (FR-029)", "file_type": "concept", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-029", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_spec_penalizacion_posicion", "label": "Penalizaci\u00f3n por posici\u00f3n (-25%/-60%)", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-027", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hace que la colocaci\u00f3n pese en el resultado; sustituida por la penalizaci\u00f3n graduada de la spec 002."}, {"id": "specs_001_draft_manager_mvp_spec_lanzadores", "label": "Lanzadores designados y tanda de penaltis (FR-029a)", "file_type": "concept", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-029a", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_spec_dorsales_equipaciones", "label": "Dorsales autom\u00e1ticos y equipaciones (FR-031a/b)", "file_type": "concept", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-031a", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_draft_manager_mvp_spec_motor_unico", "label": "Motor de simulaci\u00f3n \u00fanico (FR-032)", "file_type": "rationale", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-032", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R\u00e1pida y 2D deben producir los mismos eventos con la misma semilla (Principio V)."}, {"id": "specs_001_draft_manager_mvp_spec_cansancio", "label": "Cansancio desde minuto 65 (55 con Presi\u00f3n alta)", "file_type": "concept", "source_file": "specs/001-draft-manager-mvp/spec.md", "source_location": "FR-036", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"