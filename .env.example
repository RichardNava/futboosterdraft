DATABASE_URL=postgres://fbd:fbd@localhost:5432/futboosterdraft
SMTP_URL=smtp://localhost:1025
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PUBLIC_URL=http://localhost:5173
PORT=3000
# Opcionales (ver docs/despliegue.md)
# SMTP_FROM="Fútboosterdraft <avisos@tudominio.es>"   # obligatorio con un proveedor SMTP real
LOG_LEVEL=info
# MIGRAR_AL_ARRANCAR=false
# DB_POOL_MAX=25
# HILOS_SIMULACION=3   # por defecto, núcleos − 1; 0 = sin hilos (spec 009)
# Spec 017. En producción: PUBLIC_URL con https://, AUTH_SECRET y credenciales propias, y PROXIES_CONFIANZA obligatoria.
# PROXIES_CONFIANZA=1   # proxies delante del servidor; 0 si no hay ninguno
# METRICAS_TOKEN=       # 32 caracteres o más; sin él, /metrics responde 404 en producción
# LIMITES_DESACTIVADOS=1   # solo desarrollo y prueba de carga; el servidor no arranca con ella en producción
