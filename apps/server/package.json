{
  "name": "@fbd/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:integration:hilos": "vitest run --config vitest.config.ts --mode hilos",
    "seguridad": "(vitest run --config vitest.seguridad.config.ts --passWithNoTests || echo Revisando el resultado) && tsx tests/seguridad/resumen.ts",
    "seed": "tsx src/persistencia/seed.ts",
    "db:migrate": "tsx src/persistencia/migrar.ts",
    "db:generate": "drizzle-kit generate",
    "ajuste": "tsx src/ajustes/cli.ts",
    "premium": "tsx src/premium/cli.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.0.1",
    "@fbd/ai": "workspace:*",
    "@fbd/domain": "workspace:*",
    "@fbd/engine": "workspace:*",
    "@fbd/protocol": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.1.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.14.0",
    "tsup": "^8.3.5"
  }
}
