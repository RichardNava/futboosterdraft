{
  "name": "@fbd/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test:integration": "vitest run --config vitest.config.ts",
    "seed": "tsx src/persistencia/seed.ts",
    "db:migrate": "tsx src/persistencia/migrar.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@fbd/ai": "workspace:*",
    "@fbd/domain": "workspace:*",
    "@fbd/engine": "workspace:*",
    "@fbd/protocol": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.1.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^10.15.0",
    "tsup": "^8.3.5"
  }
}
